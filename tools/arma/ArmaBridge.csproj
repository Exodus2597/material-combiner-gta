<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>arma_bridge</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;PboArchive.cs;Terminal.cs" />
    <Compile Include="$(BisSource)/BIS.Core/**/*.cs" Exclude="$(BisSource)/BIS.Core/obj/**;$(BisSource)/BIS.Core/bin/**;$(BisSource)/BIS.Core/Terminal.cs" />
    <Compile Include="$(BisSource)/BIS.P3D/**/*.cs" Exclude="$(BisSource)/BIS.P3D/obj/**;$(BisSource)/BIS.P3D/bin/**;$(BisSource)/BIS.P3D/Export/BlenderExport.cs" />
    <Compile Include="$(BisSource)/BIS.PAA/Format/*.cs" />
  </ItemGroup>
</Project>
